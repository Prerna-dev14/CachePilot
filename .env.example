# CachePilot (CPilot) Environment Configuration
# Copy this file to .env and adjust values as needed.
# NOTE: DO NOT commit sensitive API keys or credentials to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_KEY_HEADER=X-API-Key
# Optional master API key for simple gateway auth (if empty, local dev auth bypass is active)
GATEWAY_API_KEY=

# Persistence
# PostgreSQL with pgvector extension support
DATABASE_URL=postgresql+asyncpg://cachepilot:cachepilot_secret@localhost:5432/cachepilot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=10

# Redis Cache Storage
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=cpilot:
REDIS_DEFAULT_TTL_SECONDS=3600

# Model & Embedding Provider Configuration
# Supported providers: mock, openai, anthropic, ollama
DEFAULT_LLM_PROVIDER=mock
SMALL_MODEL_NAME=mock-fast-small
LARGE_MODEL_NAME=mock-reasoning-large

DEFAULT_EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=mock-embedding-v1
EMBEDDING_DIMENSION=1536

# Provider API Keys (leave blank in git, inject via environment in production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Semantic Cache Policy Defaults
CACHE_SIMILARITY_THRESHOLD=0.88
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CORPUS_VERSION=v1.0.0
PROMPT_VERSION=v1.0.0

# Cost-Aware Routing Defaults
ROUTING_COMPLEXITY_THRESHOLD=0.65
FALLBACK_TO_LARGE_ON_ERROR=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
